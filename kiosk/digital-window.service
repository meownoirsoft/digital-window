# Server: sudo cp kiosk/digital-window.service /etc/systemd/system/ && sudo systemctl enable --now digital-window
[Unit]
Description=Digital Window server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/digital-window
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
